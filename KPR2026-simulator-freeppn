# ─── Helpers ──────────────────────────────────────────────────────────────────
def fmt_idr(value: float) -> str:
    """Format number as Indonesian Rupiah."""
    if value >= 1_000_000_000:
        return f"Rp {value/1_000_000_000:,.3f} M".replace(",", ".")
    return f"Rp {value:,.0f}".replace(",", "X").replace(".", ",").replace("X", ".")


def fmt_idr_short(value: float) -> str:
    """Compact Rupiah format for metric cards."""
    if value >= 1_000_000_000:
        b = value / 1_000_000_000
        return f"Rp {b:.3f} M".replace(".", ",") if b < 10 else f"Rp {b:.2f} M".replace(".", ",")
    elif value >= 1_000_000:
        return f"Rp {value/1_000_000:,.1f} Jt".replace(",", ".")
    return f"Rp {value:,.0f}".replace(",", "X").replace(".", ",").replace("X", ".")


def hitung_ppn(harga: float) -> tuple[float, float, str]:
    """
    Aturan Free PPN 2026:
    - Harga ≤ 2 M   → bebas PPN (0%)
    - Harga > 2 M   → PPN hanya untuk selisih di atas 2 M (sisa kena 11%)
    Mengembalikan (ppn_amount, ppn_rate_display, keterangan)
    """
    batas = 2_000_000_000
    if harga <= batas:
        return 0.0, 0.0, "Bebas PPN (Free PPN 2026 ≤ Rp 2 M)"
    else:
        kena_ppn = harga - batas
        ppn = kena_ppn * 0.11
        rate_eff = (ppn / harga) * 100
        return ppn, rate_eff, f"PPN 11% atas selisih Rp 2 M (Free PPN 2026 > Rp 2 M)"


def hitung_angsuran(pokok: float, bunga_tahunan: float, tenor_bulan: int) -> float:
    """Hitung angsuran bulanan flat / anuitas."""
    if pokok <= 0 or tenor_bulan <= 0:
        return 0.0
    if bunga_tahunan == 0:
        return pokok / tenor_bulan
    r = bunga_tahunan / 100 / 12
    return pokok * r * (1 + r)**tenor_bulan / ((1 + r)**tenor_bulan - 1)


def buat_amortisasi(pokok: float, bunga_tahunan: float, tenor_bulan: int):
    """Generate tabel amortisasi per bulan."""
    rows = []
    sisa = pokok
    r = bunga_tahunan / 100 / 12
    angsuran = hitung_angsuran(pokok, bunga_tahunan, tenor_bulan)
    for bln in range(1, tenor_bulan + 1):
        bunga_bln = sisa * r
        cicil_pokok = angsuran - bunga_bln
        sisa -= cicil_pokok
        rows.append({
            "Bulan": bln,
            "Angsuran": angsuran,
            "Bunga": bunga_bln,
            "Pokok": cicil_pokok,
            "Sisa Pokok": max(sisa, 0),
        })
    return rows


